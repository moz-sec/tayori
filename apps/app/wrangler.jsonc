{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tayori-app",
  "compatibility_date": "2026-09-29",
  "main": "./src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tayori-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ]
}
