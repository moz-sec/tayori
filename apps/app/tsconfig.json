{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/index.ts", "src/api.ts", "src/auth.ts", "cloudflare.config.ts", ".cloudflare/types"]
}
