{
  "name": "tayori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace @tayori/app",
    "dev:setup": "npm run db:setup:local",
    "dev:collector": "npm run dev --workspace @tayori/collector",
    "build": "npm run build --workspace @tayori/app && npm run build --workspace @tayori/collector",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "deploy": "npm run deploy --workspace @tayori/app && npm run deploy --workspace @tayori/collector",
    "db:migrate:local": "npm run db:migrate:local --workspace @tayori/app",
    "db:seed:local": "npm run db:seed:local --workspace @tayori/app",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @tayori/app",
    "db:migrate:preview": "npm run db:migrate:preview --workspace @tayori/app"
  }
}
