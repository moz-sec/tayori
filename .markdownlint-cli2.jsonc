{
  "config": {
    // デフォルトの80文字から120文字に緩和する。
    "MD013": {
      "line_length": 120,
    },
    // 既存の表は空白による列幅の整形を必須にしない。
    "MD060": false,
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [".agents/**", ".claude/**", ".codex/**"],
  "overrides": [
    {
      "filter": [".github/ISSUE_TEMPLATE/*.md", ".github/PULL_REQUEST_TEMPLATE.md"],
      "config": { "MD041": false },
      "combine": "merge",
    },
  ],
}
